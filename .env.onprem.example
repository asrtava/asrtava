# ==============================================================================
# ASRTAVA On-Premises Air-Gapped Environment Configuration
# Designed for 100% offline hospital datacenter installations
# Perpetual License Model: Zero recurring SaaS locks, zero phone-home requirement
# ==============================================================================

NODE_ENV=production
APP_NAME=ASRTAVA-Hospital-Instance
PORT=5000
API_PREFIX=/api/v1
DEPLOYMENT_MODE=ON_PREMISES_AIR_GAPPED

# Local PostgreSQL Server
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=asrtava_hospital
DB_USER=hospital_admin
DB_PASSWORD=SetSecureHospitalPassword2026!
DB_SSL=false
DB_POOL_MIN=5
DB_POOL_MAX=30

# Local Token Security
JWT_SECRET=SetLocalHospitalHighEntropyJWTSecretKey2026!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# Local Storage (Zero Cloud Dependency)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/opt/asrtava/storage/documents
MERKLE_AUDIT_LOG_DIR=/opt/asrtava/storage/merkle_audit

# Perpetual License Key File
PERPETUAL_LICENSE_FILE=/opt/asrtava/license/asrtava_license.key
OFFLINE_STRICT_MODE=true
ALLOW_UNLICENSED_EMERGENCY_CONTINUITY=true

