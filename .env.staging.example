# ==============================================================================
# ASRTAVA Staging Environment Variables Template
# All secrets retrieved dynamically via AWS Secrets Manager / Vault in Staging CI/CD
# ==============================================================================

NODE_ENV=staging
APP_NAME=ASRTAVA-Staging
PORT=5000
API_PREFIX=/api/v1
APP_URL=https://staging.asrtava.com
API_URL=https://staging-api.asrtava.com

# PostgreSQL Staging Configuration (Managed RDS Multi-AZ)
DB_HOST=asrtava-staging-pg.internal.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=asrtava_staging
DB_USER=asrtava_staging_app
DB_PASSWORD=<MANAGED_VIA_AWS_SECRETS_MANAGER>
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=25

# Redis Staging Configuration (ElastiCache)
REDIS_HOST=asrtava-staging-redis.internal.ap-south-1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<MANAGED_VIA_AWS_SECRETS_MANAGER>
REDIS_TLS=true

# Authentication & Cryptography
JWT_SECRET=<MANAGED_VIA_AWS_SECRETS_MANAGER_MIN_32_CHARS>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=asrtava-staging
BCRYPT_SALT_ROUNDS=12

# Object Storage (S3 KMS Encrypted)
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=asrtava-staging-medical-documents
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_KMS_KEY_ID=<KMS_KEY_ARN>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Integrations (Staging Sandboxes)
RAZORPAY_KEY_ID=<STAGING_RAZORPAY_KEY>
RAZORPAY_KEY_SECRET=<STAGING_RAZORPAY_SECRET>
WHATSAPP_API_TOKEN=<META_TEST_ACCESS_TOKEN>
WHATSAPP_PHONE_NUMBER_ID=<META_TEST_PHONE_ID>
GUPSHUP_API_KEY=<GUPSHUP_TEST_KEY>
AMAZON_SES_REGION=ap-south-1

# Logging & Monitoring
LOG_LEVEL=info
CORS_ORIGINS=https://staging.asrtava.com,https://staging-portal.asrtava.com

