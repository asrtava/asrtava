# ==============================================================================
# ASRTAVA Production Environment Variables Template
# NEVER commit raw secret values. Fetched at runtime via AWS Secrets Manager.
# Compliance: DPDP Act 2023 / HIPAA Security Rule / ISO 27001
# ==============================================================================

NODE_ENV=production
APP_NAME=ASRTAVA
PORT=5000
API_PREFIX=/api/v1
APP_URL=https://app.asrtava.com
API_URL=https://api.asrtava.com

# PostgreSQL Production Configuration (Managed RDS Multi-AZ Serverless v2)
DB_HOST=asrtava-prod-pg.internal.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=asrtava_prod
DB_USER=asrtava_prod_app
DB_PASSWORD=<INJECTED_VIA_AWS_SECRETS_MANAGER>
DB_SSL=true
DB_POOL_MIN=10
DB_POOL_MAX=50

# Redis Production Configuration (ElastiCache Multi-AZ Cluster)
REDIS_HOST=asrtava-prod-redis.internal.ap-south-1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<INJECTED_VIA_AWS_SECRETS_MANAGER>
REDIS_TLS=true

# Authentication & Cryptography (High-Entropy Secrets)
JWT_SECRET=<INJECTED_VIA_AWS_SECRETS_MANAGER_MIN_64_CHARS>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=asrtava.com
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_MASTER_KEY=<AWS_KMS_KEK_ARN>

# Object Storage (S3 KMS Server-Side Encryption + WORM Object Lock)
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=asrtava-prod-medical-documents
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/asrtava-prod-s3-key

# Rate Limiting & Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Live Production Integrations (KMS Encrypted Vault)
RAZORPAY_KEY_ID=<PROD_RAZORPAY_KEY>
RAZORPAY_KEY_SECRET=<INJECTED_VIA_SECRETS_MANAGER>
WHATSAPP_API_TOKEN=<META_PRODUCTION_SYSTEM_USER_TOKEN>
WHATSAPP_PHONE_NUMBER_ID=<META_OFFICIAL_WABA_NUMBER_ID>
GUPSHUP_API_KEY=<GUPSHUP_ENTERPRISE_KEY>
AMAZON_SES_REGION=ap-south-1

# Logging, Tracing & Monitoring
LOG_LEVEL=info
CORS_ORIGINS=https://app.asrtava.com,https://portal.asrtava.com,https://patient.asrtava.com
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.asrtava.com:4318
SENTRY_DSN=<SENTRY_PRODUCTION_DSN>

