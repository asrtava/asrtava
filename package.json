{
  "name": "asrtava-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:portal": "npm --prefix apps/web-portal run dev",
    "dev:website": "npm --prefix apps/public-website run dev",
    "dev:mobile": "npm --prefix apps/patient-mobile start",
    "build:all": "npm --prefix backend run build && npm --prefix apps/web-portal run build"
  }
}

